    "brotli-dec-wasm": "2.3.2",
    "framer-motion": "^12.23.24",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.555.0",
    "posthog-js": "^1.335.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "zustand": "^4.5.2"
