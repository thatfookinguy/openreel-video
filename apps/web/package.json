    "@openreel/ai-effects": "workspace:*",
    "@openreel/ai-hub": "workspace:*",
    "@openreel/ai-llm": "workspace:*",
    "@openreel/ai-video-gen": "workspace:*",
    "@openreel/affiliate-studio": "workspace:*",
    "@openreel/auth-and-storage": "workspace:*",
    "@openreel/brand-studio": "workspace:*",
    "@openreel/collab": "workspace:*",
    "@openreel/core": "workspace:*",
    "@openreel/graphics-studio": "workspace:*",
    "@openreel/image-studio": "workspace:*",
    "@openreel/marketxyn-studio-hub": "workspace:*",
    "@openreel/model-router": "workspace:*",
    "@openreel/personal-studio": "workspace:*",
